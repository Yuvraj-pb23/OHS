# =========================================================
# .env.example — Copy this to .env and fill in real values
# ⚠️  NEVER commit your actual .env file to version control!
# ⚠️  Rotate DJANGO_SECRET_KEY and EMAIL_HOST_PASSWORD before
#     deploying to production if they were ever exposed.
# =========================================================

# --- Django Core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key-here

# --- Debug / Deployment ---
# Set to False in production!
DEBUG=False
ALLOWED_HOSTS=openhandsolutions.com,www.openhandsolutions.com

# --- Site URL ---
SITE_URL=https://openhandsolutions.com
CSRF_TRUSTED_ORIGINS=https://openhandsolutions.com,https://www.openhandsolutions.com

# --- Email ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Open Hand Solutions <your-email@gmail.com>
SUPPORT_EMAIL=your-email@gmail.com

# --- Training Video ---
POSH_TRAINING_VIDEO_URL=https://your-s3-bucket.amazonaws.com/video.mp4

# --- REST Framework Configuration ---
REST_FRAMEWORK_ANON_THROTTLE_RATE=100/day
REST_FRAMEWORK_USER_THROTTLE_RATE=1000/day

# --- Django Axes Configuration ---
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1
AXES_LOCKOUT_TEMPLATE=
AXES_RESET_ON_SUCCESS=True
